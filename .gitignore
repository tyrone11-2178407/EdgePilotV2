# ignore virtual environments
edgepilot_environment/
.venv

# Ignore all node_modules folders
node_modules/

# Ignore all __pycache__ folders and .pyc files
__pycache__/
*.pyc
*.py[cod]

# Ignore configs
.vscode
.idea/

# Ignore local Claude configuration but share project Skills
.claude/*
!.claude/skills/
!.claude/skills/**

# Ignore environment variables and secrets
.env
*.env

# The whole env/ directory, not just env/.env. The name-based patterns above
# miss anything misnamed — a stray `env/.enprintf` sat untracked-but-visible
# because none of `.env`, `env/.env` or `*.env` matched it. Key files get
# misnamed under pressure, so ignore the directory and stop guessing names.
env/

# Ignore Chat History
data/chat_history.json
data/tool_call_history.json
data/usage_metrics.json
data/task_history.json

# Ignore settings with potentially sensitive data
data/settings.json
data/usage_monitor.pid
data/query_cache.json

# Ignore PyInstaller build artifacts
build/
dist/
*.spec

# Coverage and testing artifacts
.coverage
htmlcov/
.pytest_cache/

# OS artifacts
.DS_Store

# Docker (no Dockerfile currently)
.dockerignore

# Evaluation raw results (keep summaries)
evaluations/results/
evaluations/reliability/results/
kubeconfig-docker.yaml
